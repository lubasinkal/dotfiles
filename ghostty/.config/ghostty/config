# cyberdream — matches tmux status (#16181a bg) and nvim cyberdream palette
# Theme file: themes/cyberdream (overrides any bundled theme)
theme = cyberdream
font-family = "SpaceMono Nerd Font Mono"
font-size = 13
background-opacity = 0.9
maximize = true
copy-on-select = clipboard
window-decoration = true
background-blur-radius = 50
